SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Upstash Redis — required for production rate limiting
# Sign up at https://upstash.com → Create Database → REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Your production domain — used for CORS enforcement
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Resend — waitlist confirmation email
# Sign up at https://resend.com → API Keys → Create API Key
# Also verify your sending domain in Resend before going to production
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Coin Collector <noreply@yourdomain.com>
